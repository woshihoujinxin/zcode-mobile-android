<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_page"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fg_secondary"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/btn_retry"
            android:textColor="@color/btn_primary_fg"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_rescan"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/btn_rescan"
            android:textColor="@color/btn_primary_fg"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_open_anyway"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/btn_open_anyway"
            android:textColor="@color/fg_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
